{
  "name": "sprout-work",
  "version": "1.0.8",
  "description": "Sprout Work — task tree & focus timer desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "xyz.sproutwork.app",
    "productName": "Sprout Work",
    "publish": [
      { "provider": "github", "owner": "gcstars1071-stack", "repo": "sprout-work" }
    ],
    "files": [
      "main.js",
      "preload.js",
      "float.html",
      "float-preload.js"
    ],
    "extraResources": [
      { "from": "../app.html", "to": "app.html" },
      { "from": "../manifest.json", "to": "manifest.json" },
      { "from": "../sw.js", "to": "sw.js" },
      { "from": "../icon.png", "to": "icon.png" },
      { "from": "../icon.svg", "to": "icon.svg" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "../icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sprout-Work-Setup-${version}-${arch}.${ext}"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
